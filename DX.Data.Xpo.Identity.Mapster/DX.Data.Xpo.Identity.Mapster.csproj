<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>26.1.3.36</Version>
		<FileVersion>26.1.3.36</FileVersion>
		<Authors>Don Wibier (DevExpress)</Authors>
		<Description>XPO Based storage provider for ASP.NET Identity with Mapster implementation</Description>
		<Copyright>Copyright (c) 2020 Don Wibier</Copyright>
		<TargetFrameworks>net462;net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>10.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>
			26.1.3.36: Added a README.md with technical documentation, now embedded in the package via PackageReadmeFile.
			26.1.3.35: Rebuilt against DX.Data.Xpo.Identity 26.1.3.35 / DX.Data.Xpo.Mapster 26.1.3.32 to pick up DevExpress v26.1.3 transitively.
		</PackageReleaseNotes>
	</PropertyGroup>




	<ItemGroup Condition="'$(TargetFramework)' == 'net462'">
		<PackageReference Include="Mapster" Version="7.2.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' != 'net462'">
		<PackageReference Include="Mapster" Version="10.*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DX.Data.Xpo.Mapster\DX.Data.Xpo.Mapster.csproj" />
		<ProjectReference Include="..\DX.Data.Xpo.Identity\DX.Data.Xpo.Identity.csproj" />
		<ProjectReference Include="..\DX.Data.Xpo\DX.Data.Xpo.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
